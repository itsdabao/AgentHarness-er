# Reference only: the server reads process environment, not .env automatically.
# Set GEMINI_API_KEY privately in the terminal that starts minder-rpc.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MINDER_DATABASE=var/harness.db
MINDER_PROVIDER_MAX_ATTEMPTS=2
MINDER_PROVIDER_TIMEOUT=30
MINDER_INPUT_BUDGET=32768
MINDER_OUTPUT_TOKENS=2048
